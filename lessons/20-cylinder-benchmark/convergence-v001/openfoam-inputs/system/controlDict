FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

solver incompressibleFluid;
startFrom startTime;
startTime 4.5;
stopAt endTime;
endTime 8;
deltaT 0.005;
adjustTimeStep false;
writeControl timeStep;
writeInterval 1;
purgeWrite 0;
writeFormat ascii;
writePrecision 14;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable false;
functions
{
    forceCoefficients
    {
        type forceCoeffs;
        libs ("libforces.so");
        patches (cylinder);
        rho rhoInf;
        rhoInf 1;
        p p;
        U U;
        CofR (0.2 0.2 0);
        liftDir (0 1 0);
        dragDir (1 0 0);
        pitchAxis (0 0 1);
        magUInf 1;
        lRef 0.1;
        Aref 0.1;
        log false;
        writeControl timeStep;
        writeInterval 1;
    }

    flux_inlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        patch inlet;
        operation sum;
        fields (phi);
        writeFields false;
        log false;
        writeControl timeStep;
        writeInterval 1;
    }

    flux_outlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        patch outlet;
        operation sum;
        fields (phi);
        writeFields false;
        log false;
        writeControl timeStep;
        writeInterval 1;
    }

    flux_walls
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        patch walls;
        operation sum;
        fields (phi);
        writeFields false;
        log false;
        writeControl timeStep;
        writeInterval 1;
    }

    flux_cylinder
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        patch cylinder;
        operation sum;
        fields (phi);
        writeFields false;
        log false;
        writeControl timeStep;
        writeInterval 1;
    }
}
