FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
        {
            "alpha.water.*"
            {
                nCorrectors 2;
                nSubCycles 1;
                MULESCorr yes;
                MULES { nIter 10; tolerance 1e-2; }
                solver smoothSolver;
                smoother symGaussSeidel;
                tolerance 1e-11;
                relTol 0;
            }
            "pcorr.*"
            {
                solver PCG;
                preconditioner DIC;
                tolerance 1e-5;
                relTol 0;
            }
            p_rgh
            {
                solver PCG;
                preconditioner DIC;
                tolerance 1e-10;
                relTol 0.05;
            }
            p_rghFinal { $p_rgh; relTol 0; }
            "U.*"
            {
                solver smoothSolver;
                smoother symGaussSeidel;
                tolerance 1e-6;
                relTol 0;
                minIter 1;
            }
        }
        PIMPLE
        {
            momentumPredictor yes;
            nOuterCorrectors 8;
            nCorrectors 3;
            nNonOrthogonalCorrectors 0;
            pRefPoint (0.199375 0.099375 0.005);
            pRefValue 0;
        }
        relaxationFactors { equations { ".*" 1; } }
