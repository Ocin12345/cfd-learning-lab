FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}

dimensions [0 2 -2 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inletPeriodic  { type cyclic; }
    outletPeriodic { type cyclic; }
    lower          { type zeroGradient; }
    upper          { type zeroGradient; }
    frontAndBack   { type empty; }
}
