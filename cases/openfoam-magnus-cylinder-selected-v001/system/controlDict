FoamFile
{
 version 2.0;
 format ascii;
 class dictionary;
 object controlDict;
}

solver incompressibleFluid;
startFrom latestTime; startTime 0; stopAt endTime; endTime 10;
deltaT 0.02; adjustTimeStep false;
writeControl timeStep; writeInterval 1; purgeWrite 0;
writeFormat ascii; writePrecision 14; writeCompression off;
timeFormat general; timePrecision 10; runTimeModifiable false;
functions
{
cylinderForces
{
 type forces;
 libs ("libforces.so");
 patches (cylinder);
 rho rhoInf; rhoInf 1; p p; U U; pRef 0; porosity false;
 CofR (0 0 0);
 log false;
 executeControl timeStep; executeInterval 1;
 writeControl timeStep; writeInterval 1;
}
cylinderCoefficients
{
 type forceCoeffs;
 libs ("libforces.so");
 patches (cylinder);
 rho rhoInf; rhoInf 1; p p; U U; pRef 0; porosity false;
 CofR (0 0 0);
 log false;
 executeControl timeStep; executeInterval 1;
 writeControl timeStep; writeInterval 1;
 liftDir (0 1 0); dragDir (1 0 0); pitchAxis (0 0 1); magUInf 0.1; lRef 0.1; Aref 0.001;
}
nativeVorticity { type vorticity; libs ("libfieldFunctionObjects.so"); field U; result vorticity; executeControl timeStep; executeInterval 1; writeControl timeStep; writeInterval 1; }
nativeBodyShear { type wallShearStress; libs ("libfieldFunctionObjects.so"); patches (cylinder); log false; executeControl timeStep; executeInterval 1; writeControl timeStep; writeInterval 1; }
}
