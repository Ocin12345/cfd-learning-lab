FoamFile
{
 version 2.0;
 format ascii;
 class dictionary;
 object controlDict;
}

solver incompressibleFluid;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 2000;
deltaT 1;
writeControl timeStep;
writeInterval 100;
purgeWrite 0;
writeFormat ascii;
writePrecision 14;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable false;
functions
{
bodyForces
{
 type forces;
 libs ("libforces.so");
 patches (body);
 rho rhoInf;
 rhoInf 1;
 p p;
 U U;
 pRef 0;
 porosity false;
 CofR (0.5 0 0);
 log false;
 executeControl timeStep;
 executeInterval 1;
 writeControl timeStep;
 writeInterval 1;
}
bodyCoefficients
{
 type forceCoeffs;
 libs ("libforces.so");
 patches (body);
 rho rhoInf;
 rhoInf 1;
 p p;
 U U;
 pRef 0;
 porosity false;
 CofR (0.5 0 0);
 log false;
 executeControl timeStep;
 executeInterval 1;
 writeControl timeStep;
 writeInterval 1;
 liftDir (0 1 0);
 dragDir (1 0 0);
 pitchAxis (0 0 1);
 magUInf 0.1;
 lRef 0.1;
 Aref 0.001;
}
bodyShear
{
 type wallShearStress;
 libs ("libfieldFunctionObjects.so");
 patches (body);
 log false;
 executeControl timeStep;
 executeInterval 100;
 writeControl timeStep;
 writeInterval 100;
}
}
